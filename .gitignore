# Generated per map by `python3 -m syncai_sim.world` (MJCF + stats); rebuilt
# from <map>/octomap.bt whenever that file changes, so never committed.
cache/

# Session logs written by scripts/run_session.sh (log/stack/<robot_id>/...).
log/

# The link to the IMU's pseudo-terminal (docker-compose.can.yml), shared with
# the controller's container.
run/

# Compose interpolation (ROBOT_WS and friends) — copy .env.example and edit.
.env

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# Foxglove layouts written per robot_id by scripts/foxglove.sh from the template.
config/foxglove/layout-*.json

# MuJoCo writes this next to the cwd on some errors.
MUJOCO_LOG.TXT

# The G23's trained weights, left from before 2026-11-13 when the sim ran
# them in-process: never published from here.
policy/
