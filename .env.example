# Copy to .env and edit. docker-compose.yml interpolates these.

# The colcon workspace (SyncAI-Robot-Workspace or a worktree of it) whose
# src/ + install/ + map/ the sim container mounts at /home/syncrobotic/robot_ws.
# The nav stack it runs is whatever is BUILT there — build it first with that
# repo's docker-compose.build.yml (same image, so the artefacts are compatible).
ROBOT_WS=../SyncAI-Robot-Workspace

# The host port of the browser viewer (syncai_sim/web_view.py): open
# http://localhost:8080 while the sim runs. Ignored with a host network (the
# sim listens on 8080 directly).
SIM_WEB_VIEW_PORT=8080

# --- Network mode (docker-compose.yml) ---------------------------------------
# Default: isolated (bridge network, domain 42, this repo's cyclonedds.xml and
# config/instances/sim01.ini). To run syncai_backend / the frontend against the
# sim the way they run against robot01, use the robot's topology instead:
#
#   SIM_NETWORK_MODE=host
#   SIM_ROS_DOMAIN_ID=1
#   SIM_CYCLONEDDS_URI=/home/syncrobotic/robot_ws/config/cyclonedds.xml
#   SIM_INSTANCE_INI=${ROBOT_WS}/config/instances/robot01.ini
#
# Never on a robot's Jetson: robot01 shares that loopback on domain 1.
SIM_NETWORK_MODE=bridge
SIM_ROS_DOMAIN_ID=42
SIM_CYCLONEDDS_URI=/home/syncrobotic/sim/config/cyclonedds.xml
SIM_INSTANCE_INI=./config/instances/sim01.ini
