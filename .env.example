# Copy to .env and edit. docker-compose.yml interpolates these.

# The workspace checkout (SyncAI-Robot-Workspace or a worktree of it) the
# container mounts at /home/syncrobotic/robot_ws, for its maps (map/<name>/)
# and the robot's URDF and meshes (src/syncai_bringup). Nothing in it is built.
ROBOT_WS=../SyncAI-Robot-Workspace

# The host port of the browser viewer (syncai_sim/viewer/web_view.py): open
# http://localhost:8080 while the sim runs. Ignored with a host network.
SIM_WEB_VIEW_PORT=8080

# bridge (the default) or host: with host the sim's UDP sockets are the
# host's, which is what a controller process on the same machine finds most
# simply (no port mapping, 127.0.0.1 both ways).
SIM_NETWORK_MODE=bridge

# The instance INI mounted over the workspace's config/system.ini: the map
# ([map] name) and the spawn pose ([initial_pose]).
SIM_INSTANCE_INI=./config/instances/sim01.ini

# --- What the container starts (scripts/sim_entry.sh) -------------------------
# 1: the sim and its browser viewer come up with the container. 0: nothing.
SIM_AUTOSTART=1
# The sim's arguments. The default walks on the sim's own policies, driven from
# the viewer's panel; the controller's hardware (locomotion udp) instead:
#   SIM_ARGS=--teleop --profile /home/syncrobotic/sim/config/params/controller_profile.yaml
SIM_ARGS=--teleop
